[Unit]
Description=hushAi-agent {{INSTANCE}}: daily digest

[Service]
Type=oneshot
Environment=HUSHAI_CONFIG_ROOT={{CONFIG_ROOT}}
Environment=HUSHAI_STATE_ROOT={{STATE_ROOT}}
ExecStartPre=-{{HUSHAI}} heal --instance {{INSTANCE}} --before digest
ExecStart={{HUSHAI}} digest --instance {{INSTANCE}}
Nice=10
MemoryMax={{MEMORY_MAX}}
