[Unit]
Description=hushAi-agent {{INSTANCE}}: morning brief page (127.0.0.1 only)

[Service]
Type=simple
User={{USER}}
Environment=HOME={{HOME}}
Environment=TZ={{TZ}}
Environment=HUSHAI_CONFIG_ROOT={{CONFIG_ROOT}}
Environment=HUSHAI_STATE_ROOT={{STATE_ROOT}}
ExecStart={{HUSHAI}} serve --port {{PORT}} --instance {{INSTANCE}}
MemoryMax=64M
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
